<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>VocMeet 需要访问麦克风，以录制您本人在会议中的发言。音频仅保存在本机，不会上传。</string>
	<!-- 系统音频采集（CoreAudio process tap）走 kTCCServiceAudioCapture，
	     对应「系统设置 → 隐私与安全性 → 屏幕与系统音频录制」。
	     不声明这个 key 的话，应用**根本不会出现在那个列表里**，用户想授权也没得勾，
	     而 tap 仍会创建成功并静默录出空音频——正是 §4.1 记录的那个坑。 -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>VocMeet 需要录制系统音频，以采集会议中其他参会人的发言。音频仅保存在本机，不会上传。</string>
</dict>
</plist>
