{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VocMeet",
  "version": "0.2.0",
  "identifier": "com.vocmeet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VocMeet 声会",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../templates/meeting_default.yaml": "templates/meeting_default.yaml"
    },
    "copyright": "",
    "shortDescription": "离线会议纪要",
    "longDescription": "全量录制、会后本地转写与说话人分离、结合速记生成结构化会议纪要。"
  },
  "plugins": {}
}
